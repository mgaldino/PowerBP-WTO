  "schema_version": "1.0.0",
  "game_id": "pivotal-response-two-round-baseline",
  "created_date": "2026-08-11",
  "dependency_direction": "depends_on lists every frozen continuation interface or protocol gate required before the current node may start",
  "procedural_gates": {
    "before_r2": "independent read-only Gate 0 review must return PASS and freeze this dependency-complete bundle hash",
    "before_r1": "r2_batch_review must be PASS after all three Round-2 interfaces are PASS and frozen; each Round-1 node also consumes its local Round-2 interfaces",
    "before_entry": "r1_batch_frozen must be PASS after both Round-1 interfaces are PASS and frozen; each entry node also consumes its local Round-1 interface",
    "before_comparison": "both entry interfaces must be PASS and the common equilibrium-existence domain must be explicit",
    "skill_ready_note": "after r2_batch_review PASS, the generic DAG checker must report exactly r1_majority and r1_unanimity ready; neither may have started"
  },
  "terminal_outcomes": [
    {
      "id": "terminal_nonformation",
      "description": "weak states receive zero and H receives o_theta"
    },
    {
      "id": "terminal_current_agreement",
      "description": "current agreement includes H and implements y plus the weak allocation"
    },
    {
      "id": "terminal_current_weak_only_agreement",
      "description": "current agreement excludes H; y is reabsorbed and the weak-only allocation is implemented"
    },
    {
      "id": "terminal_failure_active_h",
      "description": "terminal active-H ballot fails; H receives o_theta in native Round-2 units and weak states receive zero"
    },
    {
      "id": "terminal_failure_weak_only",
      "description": "terminal weak-only ballot fails; weak states receive zero and H receives no new flow"
    },
    {
      "id": "terminal_failure_after_h_optout",
      "description": "H votes no in terminal majority, opts out, and the weak quota fails; H receives o_theta in native Round-2 units and weak states receive zero"
    },
    {
      "id": "terminal_quota_impossible_u_after_h_optout",
      "description": "H-no makes the original unanimity quota impossible; this is a terminal outcome and not a continuation game"
    }
  ],
