  "interface_hashing": {
    "algorithm": "sha256",
    "hash_format": "sha256:<64 lowercase hexadecimal characters>",
    "artifact_rule": "When a node passes, serialize its exact nonempty interface as a standalone UTF-8 JSON artifact and hash the artifact file bytes.",
    "pending_rule": "Pending nodes have null record collections and omit artifact_path, artifact_hash, and dependency_hashes."
  },
  "invalidation_rule": {
    "interface_change": "A changed frozen interface hash invalidates every transitive descendant.",
    "descendant_reset": "Reset each invalidated descendant to pending and remove stale results, artifact paths, artifact hashes, dependency hashes, execution-order fields, and reviews.",
    "contract_change": "A change covered by Section 12 reopens Gate 0 and invalidates all six derivation nodes.",
    "terminal_benchmark": "N7 has no derivation descendants. A finding confined to its benchmark result invalidates N7 and migration consumers, not the frozen private-information model; a shared-contract error follows contract_change."
  },
