        "assumptions_used",
        "checks_performed"
      ],
      "partition_required": true,
      "cell_ids_unique_within_collection": true,
      "exists_rule": "The family-specific record field is a nonempty list and nonexistence_certificate is null.",
      "none_rule": "The family-specific record field is an empty list and nonexistence_certificate is nonnull with nonempty ledger_claim_ids.",
      "domain_rule": "Cells are mutually exclusive and exhaustive over the declared interface domain."
    },
