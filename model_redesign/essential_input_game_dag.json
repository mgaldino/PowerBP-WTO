      "rent_private_source_id_field": "private_source_comparison_id",
      "rent_public_source_id_fields": ["majority.theta_0", "majority.theta_1", "unanimity.theta_0", "unanimity.theta_1"],
      "rent_source_interface_hash_field": "source_N6_interface_hash",
      "rent_vector_fields": ["theta_0", "theta_1"],
      "unique_rent_id_field": "rent_record_id",
      "rent_tuple_rule": "Exactly one rent record per admissible tuple of one private comparison id, four R1 public equilibrium ids (two institutions by two types), and the frozen N6 interface hash.",
      "outcome_distribution_fields": [
        "pass_with_hegemon",
        "pass_without_hegemon",
        "failure",
        "delay"
      ]
    }
  },
