      "unique_comparison_id_field": "comparison_id",
      "source_cardinality_rule": "Each record cites exactly one N3 majority equilibrium id, exactly one N4 unanimity equilibrium id, and their matching interface hashes; each admissible source pair appears exactly once."
    },
    "complete_information_benchmark_v1": {
