{
  "schema_version": "essential-input-gate0-v3",
  "contract_path": "../quality_reports/plans/2026-08-12_essential_input_gate0.md",
  "interface_hashing": {
    "algorithm": "sha256",
    "hash_format": "sha256:<64 lowercase hexadecimal characters>",
    "artifact_rule": "When a node passes, serialize its exact nonempty interface as a standalone UTF-8 JSON artifact and hash the artifact file bytes.",
    "pending_rule": "Pending nodes have null record collections and omit artifact_path, artifact_hash, dependency_hashes, frozen, and reviews."
  },
  "freeze_gate_schema": {
    "canonical_source": "contract Section 11",
    "required_node_fields": ["status", "frozen", "artifact_hash", "reviews"],
    "status_value": "pass",
    "frozen_value": true,
    "review_count": 2,
    "review_record_fields": [
      "reviewer_role",
      "reviewer_id",
      "verdict",
      "artifact_hash",
      "finding_counts"
    ],
    "reviewer_roles": ["formal_design", "game_theory"],
    "reviewer_ids_must_be_distinct": true,
    "verdict_value": "PASS",
    "finding_count_fields": ["critical", "major", "minor"],
    "finding_count_value": 0,
    "review_hash_rule": "Each review artifact_hash exactly matches the node artifact_hash.",
    "topological_readiness_scope": "Frozen dependencies are necessary but never sufficient author authorization; the contract Section 11 is the sole authority for author gates."
  },
  "invalidation_rule": {
    "interface_change": "A changed frozen interface hash invalidates every transitive descendant.",
    "descendant_reset": "Reset each invalidated descendant to pending and remove stale results, artifact paths, artifact hashes, dependency hashes, execution-order fields, and reviews.",
    "contract_change": "A change covered by Section 12 reopens Gate 0 and invalidates all six derivation nodes.",
    "terminal_benchmark": "N7 has no derivation descendants. A finding confined to its benchmark result invalidates N7 and migration consumers, not the frozen private-information model; a shared-contract error follows contract_change."
  },
  "interface_schemas": {
    "equilibrium_correspondence_v1": {
      "applies_to": ["N1", "N2", "N3", "N4"],
      "record_fields": [
        "equilibrium_id",
        "admissibility_conditions",
        "branch_classification",
